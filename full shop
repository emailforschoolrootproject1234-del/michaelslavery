<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Michael Slavery INC</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: linear-gradient(135deg, #c8102e, #ff6600);
      color: white;
      text-align: center;
    }
    header {
      padding: 60px 20px;
      background: rgba(0,0,0,0.6);
    }
    h1 { font-size: 3em; margin: 10px 0; }
    .subtitle { font-size: 1.6em; color: #ffff00; }

    .container { max-width: 1000px; margin: 0 auto; padding: 20px; }
    .section {
      background: rgba(255,255,255,0.15);
      margin: 25px auto;
      padding: 25px;
      border-radius: 15px;
      border: 3px solid white;
    }
    .product {
      background: rgba(0,0,0,0.5);
      padding: 15px;
      margin: 12px auto;
      border-radius: 10px;
      max-width: 700px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .price { color: #ffff00; font-weight: bold; }

    button {
      background: #ffff00;
      color: black;
      border: none;
      padding: 10px 20px;
      border-radius: 30px;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover { background: #ffdd00; }

    /* Cart */
    #cart-sidebar {
      position: fixed;
      top: 0;
      right: -420px;
      width: 400px;
      height: 100%;
      background: #111;
      transition: 0.4s;
      padding: 20px;
      overflow-y: auto;
      z-index: 1000;
    }
    #cart-sidebar.open { right: 0; }

    /* Checkout */
    #checkout-modal {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.95);
      z-index: 2000;
    }
    .modal-content {
      background: #222;
      max-width: 550px;
      margin: 40px auto;
      padding: 25px;
      border-radius: 15px;
      border: 3px solid #ff0;
    }
  </style>
</head>
<body>

  <header>
    <h1>Michael Slavery INC</h1>
    <p class="subtitle">Premium Live & Dead Human Workers</p>
  </header>

  <div class="container">
    <button onclick="toggleCart()" style="position:fixed; top:15px; right:15px; z-index:999; padding:12px 20px;">
      🛒 Cart (<span id="cart-count">0</span>)
    </button>

    <div class="section">
      <h2>Our Products</h2>
      <div class="product">1. Male Manual Labor Worker <span class="price">$2000</span> <button onclick="addToCart('Male Manual Labor', 2000)">Add</button></div>
      <div class="product">2. Female High-Tech Specialist <span class="price">$2000</span> <button onclick="addToCart('Female High-Tech', 2000)">Add</button></div>
      <div class="product">3. Male IT Specialist <span class="price">$500</span> <button onclick="addToCart('Male IT Specialist', 500)">Add</button></div>
      <div class="product">5. Male Management Package <span class="price">$2100</span> <button onclick="addToCart('Male Management', 2100)">Add</button></div>
      <div class="product">9. Custom Perfect Person <span class="price">$5000</span> <button onclick="addToCart('Custom Person', 5000)">Add</button></div>
    </div>
  </div>

  <!-- Cart -->
  <div id="cart-sidebar">
    <h2>Your Cart</h2>
    <div id="cart-items"></div>
    <h3>Total: $<span id="cart-total">0</span></h3>
    <button onclick="checkout()" style="width:100%; margin:10px 0;">Proceed to Checkout</button>
    <button onclick="toggleCart()" style="width:100%; background:#666;">Close</button>
  </div>

  <!-- Checkout Modal -->
  <div id="checkout-modal">
    <div class="modal-content">
      <h2>Checkout</h2>
      <div id="checkout-summary"></div>
      <h3>Total: $<span id="final-total">0</span></h3>

      <h3>Fake Payment</h3>
      <p>Card Number: 4242 4242 4242 4242</p>
      <p>Name: Michael Slavery</p>
      
      <button onclick="completePurchase()" style="background:#0f0; width:100%; padding:15px; font-size:1.2em;">COMPLETE PURCHASE</button>
      <button onclick="closeCheckout()" style="width:100%; margin-top:10px;">Cancel</button>
    </div>
  </div>

  <script>
    let cart = [];

    function addToCart(name, price) {
      cart.push({name, price});
      updateCart();
      alert(name + " added to cart!");
    }

    function updateCart() {
      let itemsHTML = '';
      let total = 0;

      cart.forEach((item, i) => {
        total += item.price;
        itemsHTML += `<div style="background:#222; padding:10px; margin:8px 0; border-radius:8px;">
          ${item.name} - $${item.price}
          <button onclick="removeItem(${i})" style="float:right; background:#c00; padding:5px;">×</button>
        </div>`;
      });

      document.getElementById('cart-items').innerHTML = itemsHTML || '<p>Cart is empty</p>';
      document.getElementById('cart-total').textContent = total;
      document.getElementById('cart-count').textContent = cart.length;
    }

    function removeItem(i) {
      cart.splice(i, 1);
      updateCart();
    }

    function toggleCart() {
      document.getElementById('cart-sidebar').classList.toggle('open');
    }

    function checkout() {
      if (cart.length === 0) return alert("Cart is empty!");
      
      let summary = '';
      let total = 0;
      cart.forEach(item => {
        summary += `<p>${item.name} - $${item.price}</p>`;
        total += item.price;
      });

      document.getElementById('checkout-summary').innerHTML = summary;
      document.getElementById('final-total').textContent = total;
      document.getElementById('checkout-modal').style.display = 'block';
    }

    function closeCheckout() {
      document.getElementById('checkout-modal').style.display = 'none';
    }

    function completePurchase() {
      alert("🎉 Purchase Successful!\n\nThank you for shopping at Michael Slavery INC.\nYour workers are being prepared for delivery... 😈");
      cart = [];
      closeCheckout();
      updateCart();
    }
  </script>
</body>
</html>
