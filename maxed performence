<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Michael Slavery INC</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: linear-gradient(135deg, #c8102e, #ff6600);
      color: white;
      text-align: center;
    }
    header {
      padding: 50px 20px;
      background: rgba(0,0,0,0.6);
    }
    h1 { font-size: 3em; margin: 10px 0; }
    .subtitle { font-size: 1.6em; color: #ffff00; }

    .container { max-width: 1100px; margin: 0 auto; padding: 20px; }

    .section {
      background: rgba(255,255,255,0.15);
      margin: 30px auto;
      padding: 30px;
      border-radius: 20px;
      border: 3px solid white;
    }

    .product {
      background: rgba(0,0,0,0.5);
      padding: 18px 25px;
      margin: 15px auto;
      border-radius: 12px;
      max-width: 850px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.3em;
    }
    .price { color: #ffff00; font-weight: bold; font-size: 1.35em; }

    button {
      background: #ffff00;
      color: black;
      border: none;
      padding: 12px 24px;
      border-radius: 30px;
      cursor: pointer;
      font-weight: bold;
      font-size: 1.1em;
    }
    button:hover { background: #ffdd00; transform: scale(1.05); }

    /* Cart */
    #cart-sidebar {
      position: fixed;
      top: 0; right: -420px;
      width: 400px;
      height: 100%;
      background: #111;
      transition: 0.4s;
      padding: 25px;
      overflow-y: auto;
      z-index: 1000;
    }
    #cart-sidebar.open { right: 0; }

    .cart-item {
      background: #222;
      padding: 12px;
      margin: 12px 0;
      border-radius: 8px;
      text-align: left;
    }

    /* Checkout */
    #checkout-modal {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.92);
      z-index: 2000;
      overflow-y: auto;
    }
    .modal-content {
      background: #1a1a1a;
      max-width: 620px;
      margin: 40px auto;
      padding: 40px 30px;
      border-radius: 15px;
      border: 3px solid #ff0;
    }
  </style>
</head>
<body>

  <header>
    <h1>Michael Slavery INC</h1>
    <p class="subtitle">Premium Live & Dead Human Workers • Since 2026</p>
  </header>

  <div class="container">

    <button onclick="toggleCart()" style="position:fixed; top:20px; right:20px; z-index:999; font-size:1.2em;">
      🛒 Cart (<span id="cart-count">0</span>)
    </button>

    <div class="section">
      <h2>Our Products</h2>
      
      <div class="product">
        1. Male - Manual Labor Worker (Live) 
        <span class="price">$2000</span>
        <button onclick="addToCart('Male Manual Labor Worker', 2000)">Add to Cart</button>
      </div>

      <div class="product">
        2. Female - High-Tech Specialist (Live) 
        <span class="price">$2000</span>
        <button onclick="addToCart('Female High-Tech Specialist', 2000)">Add to Cart</button>
      </div>

      <div class="product">
        3. Male - Computer / IT Specialist (Live) 
        <span class="price">$500</span>
        <button onclick="addToCart('Male IT Specialist', 500)">Add to Cart</button>
      </div>

      <div class="product">
        4. Female - Manual Labor Worker (Live) 
        <span class="price">$500</span>
        <button onclick="addToCart('Female Manual Labor', 500)">Add to Cart</button>
      </div>

      <div class="product">
        5. Male - Management Package (Gift Wrapped) 
        <span class="price">$2100</span>
        <button onclick="addToCart('Male Management Package', 2100)">Add to Cart</button>
      </div>

      <div class="product">
        6. Female - Psychologist Package (Gift Wrapped) 
        <span class="price">$2100</span>
        <button onclick="addToCart('Female Psychologist Package', 2100)">Add to Cart</button>
      </div>

      <div class="product">
        9. Custom Person - Perfectly Tailored 
        <span class="price">$5000</span>
        <button onclick="addToCart('Custom Tailored Person', 5000)">Add to Cart</button>
      </div>

      <div class="product">
        10. Female - Optimized For Work Needs 
        <span class="price">$300</span>
        <button onclick="addToCart('Optimized Female Worker', 300)">Add to Cart</button>
      </div>
    </div>

  </div>

  <!-- Cart Sidebar -->
  <div id="cart-sidebar">
    <h2>Your Cart</h2>
    <div id="cart-items"></div>
    <h3>Total: $<span id="cart-total">0</span></h3>
    <button onclick="checkout()" style="width:100%; padding:15px; margin:10px 0;">Proceed to Checkout</button>
    <button onclick="toggleCart()" style="width:100%; background:#666;">Close Cart</button>
  </div>

  <!-- Checkout Modal -->
  <div id="checkout-modal">
    <div class="modal-content">
      <h2>Checkout - Michael Slavery INC</h2>
      <p><strong>Shipping to:</strong> Your Location, Earth</p>
      
      <h3>Order Summary</h3>
      <div id="checkout-summary" style="text-align:left; font-size:1.2em;"></div>
      
      <h3 style="margin-top:25px;">Total: $<span id="final-total">0</span></h3>

      <h3>Payment Details</h3>
      <input type="text" value="4242 4242 4242 4242" style="width:100%; padding:12px; margin:8px 0; font-size:1.1em;" readonly><br>
      <input type="text" value="Michael Slavery" style="width:100%; padding:12px; margin:8px 0; font-size:1.1em;" readonly><br>
      <div style="display:flex; gap:10px;">
        <input type="text" value="12/28" style="flex:1; padding:12px; font-size:1.1em;" readonly>
        <input type="text" value="666" style="flex:1; padding:12px; font-size:1.1em;" readonly>
      </div>

      <button onclick="completePurchase()" style="background:#0f0; width:100%; padding:18px; font-size:1.4em; margin-top:30px;">
        PAY NOW
      </button>
      <button onclick="closeCheckout()" style="width:100%; margin-top:10px; background:#666; padding:12px;">Cancel</button>
    </div>
  </div>

  <script>
    let cart = [];

    function addToCart(name, price) {
      cart.push({name, price});
      updateCart();
      alert(name + " has been added to your cart!");
    }

    function updateCart() {
      let html = '';
      let total = 0;

      cart.forEach((item, index) => {
        total += item.price;
        html += `
          <div class="cart-item">
            ${item.name} - $${item.price}
            <button onclick="removeFromCart(${index})" style="float:right; background:#c00; padding:5px 10px;">Remove</button>
          </div>`;
      });

      document.getElementById('cart-items').innerHTML = html || '<p>Your cart is empty.</p>';
      document.getElementById('cart-total').textContent = total;
      document.getElementById('cart-count').textContent = cart.length;
    }

    function removeFromCart(index) {
      cart.splice(index, 1);
      updateCart();
    }

    function toggleCart() {
      document.getElementById('cart-sidebar').classList.toggle('open');
    }

    function checkout() {
      if (cart.length === 0) {
        alert("Your cart is empty!");
        return;
      }
      toggleCart();

      let summary = '';
      let total = 0;
      cart.forEach(item => {
        summary += `<p>${item.name} — $${item.price}</p>`;
        total += item.price;
      });

      document.getElementById('checkout-summary').innerHTML = summary;
      document.getElementById('final-total').textContent = total;
      document.getElementById('checkout-modal').style.display = 'block';
    }

    function closeCheckout() {
      document.getElementById('checkout-modal').style.display = 'none';
    }

    function completePurchase() {
      alert("🎉 ORDER SUCCESSFUL!\n\nYour order is ready.\nThank you for shopping at Michael Slavery INC.\nYour workers will be delivered soon... 😈");
      cart = [];
      closeCheckout();
      updateCart();
    }
  </script>
</body>
</html>
